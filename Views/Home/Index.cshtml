@model UniversityApp.Models.University
@{
    ViewData["Title"] = "Welcome";
}

<main class="page-content">
    <section class="welcome-banner">
        <p class="eyebrow">A community for curious minds</p>
        <h1>Welcome to GSU</h1>
        <p class="welcome-name">@Model.Name</p>
    </section>

    <section class="info-section" aria-labelledby="university-details">
        <div class="section-heading">
            <p class="eyebrow">Get to know us</p>
            <h2 id="university-details">University details</h2>
        </div>
        <dl class="details-list">
            <div class="detail-row">
                <dt>Location</dt>
                <dd>@Model.Address</dd>
            </div>
            <div class="detail-row">
                <dt>Email</dt>
                <dd><a href="mailto:@Model.Email">@Model.Email</a></dd>
            </div>
            <div class="detail-row">
                <dt>Phone</dt>
                <dd>@Model.Phone</dd>
            </div>
        </dl>
    </section>
</main>